generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  player_free
  player_pro
  player_premium
  support
}

enum UserStatus {
  active
  inactive
  blocked
}

enum PlanStatus {
  active
  inactive
}

enum SubscriptionStatus {
  active
  expired
  cancelled
}

enum MatchStatus {
  pending
  processing
  analyzed
  failed
}

enum ProcessingStatus {
  pending
  processing
  done
  failed
}

enum AIAnalysisStatus {
  pending
  processing
  done
  failed
}

enum ErrorSeverity {
  low
  medium
  high
  critical
}

enum CaptureSourceType {
  window
  monitor
  region
}

enum CaptureSessionStatus {
  starting
  running
  paused
  stopped
  failed
}

enum FrameAnalysisStatus {
  pending
  analyzed
  skipped
  failed
}

// Fase 2 (heurística de motion/frame-diff, sem leitura de HUD específica de jogo):
// o detector MVP só emite menu (proxy "estático") e match_running (proxy "ativo").
// paused/replay/post_match ficam reservados para uma heurística futura mais específica.
enum FrameGameState {
  menu
  match_running
  paused
  replay
  post_match
}

enum SegmentReason {
  event_detected
  manual
  periodic
}

enum SegmentStatus {
  pending
  processing
  done
  failed
}

enum FeedbackChannel {
  text
  voice
  overlay
  report
}

enum TacticalPossession {
  user
  opponent
  contested
  unknown
}

enum TacticalTeam {
  user
  opponent
}

// Ver docs/tactical-engine-domain.md (TacticalPattern) e TASKS.md (Fase 4, Tarefa 21).
enum TacticalPatternSeverity {
  LOW
  MEDIUM
  HIGH
}

// Domínio Game (docs/efootball-architecture.md, Tarefa 2) — identifica de qual jogo de futebol
// virtual um dado (Player, UserSquad, LearningPath, ...) pertence. Um valor por jogo suportado;
// EFOOTBALL é o único ativo nesta fase. Novos jogos (EA_SPORTS_FC, UFL, ...) entram como novos
// valores de enum + uma nova linha em Game, nunca como string solta em outra tabela.
enum GameProvider {
  EFOOTBALL
}

enum GameDataSourceKind {
  official
  community
  manual
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String     @map("password_hash")
  role         UserRole   @default(player_free)
  status       UserStatus @default(active)
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")
  deletedAt     DateTime?  @map("deleted_at")
  loginAttempts Int        @default(0) @map("login_attempts")
  lockedUntil   DateTime?  @map("locked_until")

  preferences   UserPreferences?
  subscription  Subscription?
  matches       Match[]
  usageLogs     UsageLog[]
  auditLogs     AuditLog[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  captureSessions     CaptureSession[]
  tacticalPatterns    TacticalPattern[]
  tacticalProfile     TacticalProfile?
  cardScans           CardScan[]
  userPlayers         UserPlayer[]
  userSquads          UserSquad[]
  economyRecommendations EconomyRecommendation[]
  lessonProgress      UserLessonProgress[]
  learningProfile     UserLearningProfile?
  progressSnapshots   UserProgressSnapshot[]
  learningRecommendation LearningRecommendation?
  aiCallLogs          AiCallLog[]

  @@index([email])
  @@index([status])
  @@map("users")
}

model UserPreferences {
  id            String   @id @default(cuid())
  userId        String   @unique @map("user_id")
  feedbackLevel String   @default("normal") @map("feedback_level")
  voiceEnabled  Boolean  @default(false) @map("voice_enabled")
  language      String   @default("pt-BR")
  favoriteMode  String?  @map("favorite_mode")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model Plan {
  id                   String     @id @default(cuid())
  name                 String
  monthlyAnalysisLimit Int        @map("monthly_analysis_limit")
  maxVideoMinutes      Int        @map("max_video_minutes")
  liveFeedbackEnabled  Boolean    @default(false) @map("live_feedback_enabled")
  price                Decimal    @db.Decimal(10, 2)
  status               PlanStatus @default(active)
  createdAt            DateTime   @default(now()) @map("created_at")
  updatedAt            DateTime   @updatedAt @map("updated_at")

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id        String             @id @default(cuid())
  userId    String             @unique @map("user_id")
  planId    String             @map("plan_id")
  status    SubscriptionStatus @default(active)
  startedAt DateTime           @map("started_at")
  expiresAt DateTime?          @map("expires_at")
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])
  plan Plan @relation(fields: [planId], references: [id])

  @@index([userId])
  @@index([status])
  @@map("subscriptions")
}

model Match {
  id            String      @id @default(cuid())
  userId        String      @map("user_id")
  title         String?
  gameMode      String?     @map("game_mode")
  platform      String      @default("xbox")
  matchDate     DateTime?   @map("match_date")
  scoreUser     Int?        @map("score_user")
  scoreOpponent Int?        @map("score_opponent")
  playerTeam    String?     @map("player_team")
  status        MatchStatus @default(pending)
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  deletedAt     DateTime?   @map("deleted_at")

  user       User            @relation(fields: [userId], references: [id])
  video      MatchVideo?
  gameEvents GameEvent[]
  errors     DetectedError[]
  analysis   AIAnalysis?
  report     MatchReport?
  captureSessions CaptureSession[]
  videoSegments   VideoSegment[]
  coachFeedbacks  CoachFeedback[]
  tacticalSnapshots TacticalSnapshot[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("matches")
}

model MatchVideo {
  id               String          @id @default(cuid())
  matchId          String          @unique @map("match_id")
  fileUrl          String          @map("file_url")
  fileName         String          @map("file_name")
  fileSize         BigInt          @map("file_size")
  durationSeconds  Int?            @map("duration_seconds")
  format           String
  processingStatus ProcessingStatus @default(pending) @map("processing_status")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@index([matchId])
  @@index([processingStatus])
  @@map("match_videos")
}

model GameEvent {
  id               String   @id @default(cuid())
  matchId          String   @map("match_id")
  captureSessionId String?  @map("capture_session_id")
  segmentId        String?  @map("segment_id")
  eventType        String   @map("event_type")
  category         String
  // Unidade de timestampStart/End depende da origem, sem flag por linha:
  // - captureSessionId != null (Fase 2, capture-frame-analysis.worker.ts) → milissegundos
  // - captureSessionId == null (upload manual, game-analysis.service.ts) → segundos
  timestampStart   Int      @map("timestamp_start")
  timestampEnd     Int?     @map("timestamp_end")
  description      String?
  confidence       Float?
  evidence         Json?
  createdAt        DateTime @default(now()) @map("created_at")

  match          Match           @relation(fields: [matchId], references: [id], onDelete: Cascade)
  captureSession CaptureSession? @relation(fields: [captureSessionId], references: [id])
  segment        VideoSegment?   @relation(fields: [segmentId], references: [id])
  errors         DetectedError[]
  feedbacks      CoachFeedback[]

  @@index([matchId])
  @@index([captureSessionId])
  @@map("game_events")
}

model DetectedError {
  id          String        @id @default(cuid())
  matchId     String        @map("match_id")
  eventId     String?       @map("event_id")
  errorType   String        @map("error_type")
  category    String
  severity    ErrorSeverity @default(medium)
  description String
  suggestion  String?
  frameUrl    String?       @map("frame_url")
  createdAt   DateTime      @default(now()) @map("created_at")

  match Match      @relation(fields: [matchId], references: [id], onDelete: Cascade)
  event GameEvent? @relation(fields: [eventId], references: [id])

  @@index([matchId])
  @@map("detected_errors")
}

model AIAnalysis {
  id            String           @id @default(cuid())
  matchId       String           @unique @map("match_id")
  modelUsed     String           @map("model_used")
  promptVersion String           @map("prompt_version")
  rawResponse   String?          @map("raw_response") @db.Text
  summary       String?          @db.Text
  costEstimate  Decimal?         @map("cost_estimate") @db.Decimal(10, 6)
  status        AIAnalysisStatus @default(pending)
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@index([matchId])
  @@index([status])
  @@map("ai_analyses")
}

model MatchReport {
  id             String   @id @default(cuid())
  matchId        String   @unique @map("match_id")
  overallScore   Float?   @map("overall_score")
  attackScore    Float?   @map("attack_score")
  defenseScore   Float?   @map("defense_score")
  passingScore   Float?   @map("passing_score")
  decisionScore  Float?   @map("decision_score")
  mainProblem    String?  @map("main_problem")
  recommendation String?  @db.Text
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@index([matchId])
  @@map("match_reports")
}

model UsageLog {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  action       String
  resourceType String   @map("resource_type")
  resourceId   String?  @map("resource_id")
  amountUsed   Float    @default(1) @map("amount_used")
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
  @@map("usage_logs")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  module    String
  action    String
  ipAddress String?  @map("ip_address")
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model AppSetting {
  id               String   @id @default("global")
  anthropicApiKey  String?  @map("anthropic_api_key")
  openaiApiKey     String?  @map("openai_api_key")
  deepSeekApiKey   String?  @map("deepseek_api_key")
  groqApiKey       String?  @map("groq_api_key")
  geminiApiKey     String?  @map("gemini_api_key")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

model CaptureSession {
  id               String               @id @default(cuid())
  userId           String               @map("user_id")
  matchId          String?              @map("match_id")
  sourceType       CaptureSourceType    @map("source_type")
  sourceName       String               @map("source_name")
  resolutionWidth  Int?                 @map("resolution_width")
  resolutionHeight Int?                 @map("resolution_height")
  captureFps       Int                  @default(2) @map("capture_fps")
  analysisFps      Int                  @default(1) @map("analysis_fps")
  status           CaptureSessionStatus @default(starting)
  errorMessage     String?              @map("error_message")
  startedAt        DateTime?            @map("started_at")
  endedAt          DateTime?            @map("ended_at")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")

  user     User            @relation(fields: [userId], references: [id])
  match    Match?          @relation(fields: [matchId], references: [id])
  frames   FrameSample[]
  segments VideoSegment[]
  events   GameEvent[]

  @@index([userId])
  @@index([matchId])
  @@index([status])
  @@map("capture_sessions")
}

model FrameSample {
  id               String               @id @default(cuid())
  captureSessionId String               @map("capture_session_id")
  timestampMs      Int                  @map("timestamp_ms")
  framePath        String               @map("frame_path")
  width            Int?
  height           Int?
  confidenceScore  Float?               @map("confidence_score")
  gameState        FrameGameState?      @map("game_state")
  motionScore      Float?               @map("motion_score")
  analysisStatus   FrameAnalysisStatus  @default(pending) @map("analysis_status")
  createdAt        DateTime             @default(now()) @map("created_at")

  session CaptureSession @relation(fields: [captureSessionId], references: [id], onDelete: Cascade)

  @@index([captureSessionId])
  @@map("frame_samples")
}

model VideoSegment {
  id               String        @id @default(cuid())
  captureSessionId String        @map("capture_session_id")
  matchId          String?       @map("match_id")
  startTimestampMs Int           @map("start_timestamp_ms")
  endTimestampMs   Int           @map("end_timestamp_ms")
  filePath         String        @map("file_path")
  reason           SegmentReason @default(manual)
  status           SegmentStatus @default(pending)
  createdAt        DateTime      @default(now()) @map("created_at")

  session CaptureSession @relation(fields: [captureSessionId], references: [id], onDelete: Cascade)
  match   Match?         @relation(fields: [matchId], references: [id])
  events  GameEvent[]

  @@index([captureSessionId])
  @@index([matchId])
  @@map("video_segments")
}

model CoachFeedback {
  id               String          @id @default(cuid())
  matchId          String          @map("match_id")
  eventId          String?         @map("event_id")
  feedbackType     String          @map("feedback_type")
  message          String          @db.Text
  confidence       Float?
  deliveredChannel FeedbackChannel @map("delivered_channel")
  deliveredAt      DateTime?       @map("delivered_at")
  createdAt        DateTime        @default(now()) @map("created_at")

  match Match      @relation(fields: [matchId], references: [id], onDelete: Cascade)
  event GameEvent? @relation(fields: [eventId], references: [id])

  @@index([matchId])
  @@map("coach_feedbacks")
}

// Instante estruturado da partida consumido pelo Tactical Engine (ver
// docs/tactical-engine-domain.md — TacticalGameState). Hoje alimentado só por fixtures de
// teste: não existe, em nenhum lugar do projeto, uma fonte real de posição de jogadores/bola
// (ver docs/tactical-engine-current-state.md, seção 2). @@index([createdAt]) existe para
// suportar uma futura rotina de expurgo/agregação — nenhuma política de retenção implementada
// ainda (risco documentado na auditoria).
model TacticalSnapshot {
  id                 String             @id @default(cuid())
  matchId            String             @map("match_id")
  timestampMs        Int                @map("timestamp_ms")
  possession         TacticalPossession @default(unknown)
  ballX              Float?             @map("ball_x")
  ballY              Float?             @map("ball_y")
  controlledPlayerId String?            @map("controlled_player_id")
  confidence         Float
  createdAt          DateTime           @default(now()) @map("created_at")

  match   Match            @relation(fields: [matchId], references: [id], onDelete: Cascade)
  players TacticalPlayer[]

  @@index([matchId])
  @@index([matchId, timestampMs])
  @@index([createdAt])
  @@map("tactical_snapshots")
}

model TacticalPlayer {
  id         String       @id @default(cuid())
  snapshotId String       @map("snapshot_id")
  trackingId String       @map("tracking_id")
  team       TacticalTeam
  x          Float
  y          Float
  role       String?
  confidence Float
  createdAt  DateTime     @default(now()) @map("created_at")

  snapshot TacticalSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@index([snapshotId])
  @@map("tactical_players")
}

// Ver docs/tactical-engine-domain.md (TacticalPattern) e TASKS.md (Fase 4, Tarefa 21) —
// recorrência de um princípio (seguido ou negligenciado) através de MÚLTIPLAS partidas do
// mesmo usuário, produzida por tactical-pattern.detector.ts e persistida/atualizada
// (upsert) por tactical-patterns.service.ts a cada nova partida analisada pelo motor.
model TacticalPattern {
  id              String                  @id @default(cuid())
  userId          String                  @map("user_id")
  pattern         String
  frequency       Int
  confidence      Float
  severity        TacticalPatternSeverity
  firstDetectedAt DateTime                @map("first_detected_at")
  lastDetectedAt  DateTime                @map("last_detected_at")
  updatedAt       DateTime                @updatedAt @map("updated_at")
  createdAt       DateTime                @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, pattern])
  @@index([userId])
  @@map("tactical_patterns")
}

// Ver docs/tactical-engine-domain.md e TASKS.md (Fase 4, Tarefa 22) — perfil estratégico
// evolutivo do usuário, agregado a partir dos TacticalPattern já persistidos (não recalcula
// nada geométrico por si só — camada fina de agregação, mesmo espírito de
// tactical-snapshots.service.ts). Uma linha por usuário (chave primária = userId), sempre
// sobrescrita (upsert) na última agregação — não guarda histórico de perfis anteriores.
model TacticalProfile {
  userId               String   @id @map("user_id")
  dominantPrinciples   Json     @map("dominant_principles")
  neglectedPrinciples  Json     @map("neglected_principles")
  sampleSize           Int      @map("sample_size")
  updatedAt            DateTime @updatedAt @map("updated_at")
  createdAt            DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("tactical_profiles")
}

// Ver docs/efootball-architecture.md (Tarefa 2) — raiz do domínio multi-jogo. Toda tabela nova
// do módulo eFootball (e de futuros jogos) referencia Game.id em vez de repetir uma string solta
// tipo game = "efootball" em cada tabela.
model Game {
  id        String       @id @default(cuid())
  provider  GameProvider @unique
  name      String
  active    Boolean      @default(true)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  versions    GameVersion[]
  dataSources GameDataSource[]
  players     Player[]
  formations  Formation[]
  userSquads  UserSquad[]
  packs       Pack[]
  learningPaths LearningPath[]
  progressSnapshots UserProgressSnapshot[]
  documentationSources DocumentationSource[]
  gameDocuments GameDocument[]

  @@map("games")
}

model GameVersion {
  id         String    @id @default(cuid())
  gameId     String    @map("game_id")
  label      String
  releasedAt DateTime? @map("released_at")
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now()) @map("created_at")

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId])
  @@map("game_versions")
}

model GameDataSource {
  id        String             @id @default(cuid())
  gameId    String             @map("game_id")
  name      String
  kind      GameDataSourceKind
  baseUrl   String?            @map("base_url")
  active    Boolean            @default(true)
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)
  importRuns DataImportRun[]

  @@index([gameId])
  @@map("game_data_sources")
}

enum DataImportStatus {
  processing
  done
  partial
  failed
}

enum DataImportChangeType {
  player_created
  card_created
  card_updated
  card_removed
}

// Ver docs/efootball-architecture.md (Tarefa 4) — 1 linha por execução do pipeline
// efootball-data-provider (fetch → normalize → validate → version → import). "checksum" detecta
// reimportações idênticas do mesmo lote; contadores resumem o resultado sem precisar reagregar
// DataImportChange a cada consulta.
model DataImportRun {
  id               String           @id @default(cuid())
  gameDataSourceId String           @map("game_data_source_id")
  source           String
  sourceVersion    String           @map("source_version")
  importedAt       DateTime         @map("imported_at")
  checksum         String
  recordCount      Int              @map("record_count")
  createdCount     Int              @default(0) @map("created_count")
  updatedCount     Int              @default(0) @map("updated_count")
  removedCount     Int              @default(0) @map("removed_count")
  unchangedCount   Int              @default(0) @map("unchanged_count")
  errorCount       Int              @default(0) @map("error_count")
  status           DataImportStatus @default(processing)
  errorDetail      Json?            @map("error_detail")
  createdAt        DateTime         @default(now()) @map("created_at")

  gameDataSource GameDataSource     @relation(fields: [gameDataSourceId], references: [id], onDelete: Cascade)
  changes        DataImportChange[]

  @@index([gameDataSourceId])
  @@index([createdAt])
  @@map("data_import_runs")
}

// Trilha de auditoria por entidade alterada num DataImportRun — permite responder "o que mudou
// nesta importação" sem recalcular o diff depois (registrado no momento em que já foi calculado).
model DataImportChange {
  id              String               @id @default(cuid())
  dataImportRunId String               @map("data_import_run_id")
  changeType      DataImportChangeType @map("change_type")
  entityType      String               @map("entity_type")
  entityId        String               @map("entity_id")
  diff            Json?
  createdAt       DateTime             @default(now()) @map("created_at")

  dataImportRun DataImportRun @relation(fields: [dataImportRunId], references: [id], onDelete: Cascade)

  @@index([dataImportRunId])
  @@map("data_import_changes")
}

// Ver docs/efootball-architecture.md (Tarefa 3) — Player é o atleta; PlayerCard é uma versão
// específica dele (ex.: "Kvaratskhelia - Standard" vs. "Kvaratskhelia - Epic"). NUNCA tratar
// cartas diferentes do mesmo atleta como o mesmo objeto (Princípio 1 do módulo eFootball:
// atributos/overall/skills vêm sempre de fonte validada, nunca de IA generativa).
model Player {
  id             String   @id @default(cuid())
  gameId         String   @map("game_id")
  externalId     String   @map("external_id")
  name           String
  normalizedName String   @map("normalized_name")
  nationality    String?
  preferredFoot  String?  @map("preferred_foot")
  height         Int?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  game  Game         @relation(fields: [gameId], references: [id], onDelete: Cascade)
  cards PlayerCard[]

  @@unique([gameId, externalId])
  @@index([gameId])
  @@index([normalizedName])
  @@map("players")
}

// Campos de proveniência (source/sourceVersion/validFrom/validUntil/lastVerifiedAt) seguem a
// "Regra de dados" do módulo eFootball — nenhuma carta é assumida como válida para sempre.
model PlayerCard {
  id             String    @id @default(cuid())
  playerId       String    @map("player_id")
  externalId     String    @map("external_id")
  cardType       String    @map("card_type")
  version        String
  overallBase    Int       @map("overall_base")
  maxLevel       Int       @map("max_level")
  position       String
  imageUrl       String?   @map("image_url")
  releaseDate    DateTime? @map("release_date")
  active         Boolean   @default(true)
  dataVersion    String    @map("data_version")
  source         String?
  sourceVersion  String?   @map("source_version")
  validFrom      DateTime? @map("valid_from")
  validUntil     DateTime? @map("valid_until")
  lastVerifiedAt DateTime? @map("last_verified_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  player     Player            @relation(fields: [playerId], references: [id], onDelete: Cascade)
  positions  PlayerPosition[]
  stats      PlayerStat[]
  skills     PlayerSkill[]
  playStyles PlayerPlayStyle[]
  versions   CardVersion[]
  cardScans  CardScan[]
  userPlayers UserPlayer[]
  packTargets PackTargetPlayer[]

  @@unique([playerId, externalId])
  @@index([playerId])
  @@index([position])
  @@index([cardType])
  @@map("player_cards")
}

// Posições adicionais além de PlayerCard.position (primária) — cobre cartas que o jogo permite
// posicionar em mais de um papel.
model PlayerPosition {
  id           String  @id @default(cuid())
  playerCardId String  @map("player_card_id")
  position     String
  isPrimary    Boolean @default(false) @map("is_primary")

  playerCard PlayerCard @relation(fields: [playerCardId], references: [id], onDelete: Cascade)

  @@unique([playerCardId, position])
  @@index([playerCardId])
  @@map("player_positions")
}

model PlayerStat {
  id           String @id @default(cuid())
  playerCardId String @map("player_card_id")
  statKey      String @map("stat_key")
  baseValue    Int    @map("base_value")
  maxValue     Int    @map("max_value")

  playerCard PlayerCard @relation(fields: [playerCardId], references: [id], onDelete: Cascade)

  @@unique([playerCardId, statKey])
  @@index([playerCardId])
  @@map("player_stats")
}

model PlayerSkill {
  id           String @id @default(cuid())
  playerCardId String @map("player_card_id")
  skillKey     String @map("skill_key")

  playerCard PlayerCard @relation(fields: [playerCardId], references: [id], onDelete: Cascade)

  @@unique([playerCardId, skillKey])
  @@index([playerCardId])
  @@map("player_skills")
}

model PlayerPlayStyle {
  id           String  @id @default(cuid())
  playerCardId String  @map("player_card_id")
  playStyleKey String  @map("play_style_key")
  tier         String?

  playerCard PlayerCard @relation(fields: [playerCardId], references: [id], onDelete: Cascade)

  @@unique([playerCardId, playStyleKey])
  @@index([playerCardId])
  @@map("player_play_styles")
}

// Snapshot do estado de uma PlayerCard num dado dataVersion — usado pelo pipeline de importação
// (Tarefa 4) para detectar alteração de atributos entre importações sem perder o histórico.
model CardVersion {
  id            String    @id @default(cuid())
  playerCardId  String    @map("player_card_id")
  dataVersion   String    @map("data_version")
  source        String?
  sourceVersion String?   @map("source_version")
  snapshot      Json
  validFrom     DateTime  @map("valid_from")
  validUntil    DateTime? @map("valid_until")
  createdAt     DateTime  @default(now()) @map("created_at")

  playerCard PlayerCard @relation(fields: [playerCardId], references: [id], onDelete: Cascade)

  @@index([playerCardId])
  @@map("card_versions")
}

enum CardScanStatus {
  AUTO_IDENTIFIED
  NEEDS_CONFIRMATION
  NEEDS_NEW_IMAGE
  INVALID_IMAGE
}

// Ver docs/efootball-architecture.md (Tarefa 7) — 1 linha por tentativa de scan (mesmo com
// resultado ruim/inválido, para medir scanner_success_rate depois, Tarefa 21). "confidenceScore"
// e "candidateCardIds" nunca vêm de IA generativa — são o resultado do matching determinístico
// (similaridade de texto + sinais da carta) contra Player/PlayerCard já existentes.
model CardScan {
  id                  String         @id @default(cuid())
  userId              String         @map("user_id")
  status              CardScanStatus
  confidenceScore     Float?         @map("confidence_score")
  matchedPlayerCardId String?        @map("matched_player_card_id")
  candidateCardIds    Json?          @map("candidate_card_ids")
  rawExtraction       Json?          @map("raw_extraction")
  reviewedAt          DateTime?      @map("reviewed_at")
  createdAt           DateTime       @default(now()) @map("created_at")

  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  matchedPlayerCard PlayerCard? @relation(fields: [matchedPlayerCardId], references: [id])

  @@index([userId])
  @@index([matchedPlayerCardId])
  @@map("card_scans")
}

// Ver docs/efootball-architecture.md (Tarefa 8) — "Meu Elenco": jogadores que o usuário adicionou
// (por pesquisa, scanner ou manualmente — todos os 3 caminhos convergem para um playerCardId, a
// origem é só um detalhe de UI, não um campo persistido). Uma linha por (userId, playerCardId) —
// nunca duplicado. "raridade"/"tipo" dos filtros do frontend mapeiam para PlayerCard.cardType
// (não existe um campo de raridade separado no schema).
model UserPlayer {
  id               String   @id @default(cuid())
  userId           String   @map("user_id")
  playerCardId     String   @map("player_card_id")
  currentLevel     Int      @map("current_level")
  favoritePosition String?  @map("favorite_position")
  userNotes        String?  @map("user_notes")
  isFavorite       Boolean  @default(false) @map("is_favorite")
  currentBuildId   String?  @map("current_build_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  playerCard PlayerCard        @relation(fields: [playerCardId], references: [id])
  builds     UserPlayerBuild[]
  squadSlots SquadPlayer[]

  @@unique([userId, playerCardId])
  @@index([userId])
  @@map("user_players")
}

// Build salva pelo usuário para um UserPlayer — snapshot do resultado do Player Build Engine
// (Tarefa 5) ou de uma alocação manual; nunca recalculado aqui (motor determinístico já validou
// os limites no momento em que o resultado foi gerado, ver player-build-engine).
model UserPlayerBuild {
  id                   String   @id @default(cuid())
  userPlayerId         String   @map("user_player_id")
  strategy             String
  position             String
  level                Int
  allocation           Json
  computedAttributes   Json     @map("computed_attributes")
  roleScore            Float    @map("role_score")
  totalPointsUsed      Int      @map("total_points_used")
  totalPointsAvailable Int      @map("total_points_available")
  createdAt            DateTime @default(now()) @map("created_at")

  userPlayer UserPlayer @relation(fields: [userPlayerId], references: [id], onDelete: Cascade)

  @@index([userPlayerId])
  @@map("user_player_builds")
}

// Ver docs/efootball-architecture.md (Tarefa 9) — catálogo de formações suportadas (dado próprio
// do CoachPlay: layout padrão de futebol, não um dump de dados do eFootball). Cada
// FormationPosition é 1 "slot" (ex.: "CB1") exigindo uma posição (mesmo vocabulário de
// PlayerCard.position); "order" fixa a ordem determinística que o squad-builder.engine usa pra
// alocar jogadores slot a slot. x/y normalizados (0-1), mesmo espírito de PitchCoordinate do
// tactical-engine.
model Formation {
  id        String   @id @default(cuid())
  gameId    String   @map("game_id")
  code      String
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  game       Game                @relation(fields: [gameId], references: [id], onDelete: Cascade)
  positions  FormationPosition[]
  userSquads UserSquad[]

  @@unique([gameId, code])
  @@map("formations")
}

model FormationPosition {
  id          String @id @default(cuid())
  formationId String @map("formation_id")
  slot        String
  position    String
  order       Int
  x           Float
  y           Float

  formation Formation @relation(fields: [formationId], references: [id], onDelete: Cascade)

  @@unique([formationId, slot])
  @@index([formationId])
  @@map("formation_positions")
}

// Elenco salvo pelo usuário — startingXI/bench calculados pelo squad-builder.engine
// (determinístico) na hora de gerar, persistidos aqui via SquadPlayer.isStarting.
model UserSquad {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  gameId      String   @map("game_id")
  name        String
  formationId String?  @map("formation_id")
  isDefault   Boolean  @default(false) @map("is_default")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  game      Game          @relation(fields: [gameId], references: [id], onDelete: Cascade)
  formation Formation?    @relation(fields: [formationId], references: [id])
  players   SquadPlayer[]

  @@index([userId])
  @@map("user_squads")
}

model SquadPlayer {
  id           String  @id @default(cuid())
  userSquadId  String  @map("user_squad_id")
  userPlayerId String  @map("user_player_id")
  slot         String?
  isStarting   Boolean @default(false) @map("is_starting")

  userSquad  UserSquad  @relation(fields: [userSquadId], references: [id], onDelete: Cascade)
  userPlayer UserPlayer @relation(fields: [userPlayerId], references: [id], onDelete: Cascade)

  @@unique([userSquadId, userPlayerId])
  @@index([userSquadId])
  @@map("squad_players")
}

enum PackCurrency {
  coins
  gp
}

enum EconomyRecommendationResult {
  RECOMMENDED
  NEUTRAL
  NOT_RECOMMENDED
  INSUFFICIENT_DATA
}

// Ver docs/efootball-architecture.md (Tarefa 11) — "probability" em PackTargetPlayer é sempre
// null até vir de uma fonte validada (Regra de dados) — o Economy Advisor NUNCA infere/inventa
// probabilidade de pack; sem probabilidade verificada, a recomendação é sempre
// INSUFFICIENT_DATA (ver economy-advisor.engine.ts).
model Pack {
  id             String       @id @default(cuid())
  gameId         String       @map("game_id")
  externalId     String       @map("external_id")
  name           String
  cost           Int
  currency       PackCurrency
  oddsSource     String?      @map("odds_source")
  oddsVerifiedAt DateTime?    @map("odds_verified_at")
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  game            Game                     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  targets         PackTargetPlayer[]
  recommendations EconomyRecommendation[]

  @@unique([gameId, externalId])
  @@map("packs")
}

model PackTargetPlayer {
  id           String @id @default(cuid())
  packId       String @map("pack_id")
  playerCardId String @map("player_card_id")
  probability  Float?

  pack       Pack       @relation(fields: [packId], references: [id], onDelete: Cascade)
  playerCard PlayerCard @relation(fields: [playerCardId], references: [id])

  @@unique([packId, playerCardId])
  @@index([packId])
  @@map("pack_target_players")
}

// 1 linha por avaliação pedida pelo usuário — trilha de auditoria ("por que o CoachPlay
// recomendou/não recomendou esse pack nesse momento"), nunca recalculada depois.
model EconomyRecommendation {
  id             String                       @id @default(cuid())
  userId         String                       @map("user_id")
  packId         String                       @map("pack_id")
  recommendation EconomyRecommendationResult
  score          Float?
  explanation    String?                      @db.Text
  createdAt      DateTime                     @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  pack Pack @relation(fields: [packId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([packId])
  @@map("economy_recommendations")
}

enum LearningLevel {
  BEGINNER
  CASUAL
  INTERMEDIATE
  ADVANCED
  COMPETITIVE
}

enum LessonProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

// Ver docs/efootball-architecture.md (Tarefa 12) — Academia CoachPlay. Uma trilha por nível;
// conteúdo (Lesson.content) é texto próprio do CoachPlay (didático, genérico), nunca dado de
// jogo que precise vir de fonte validada.
model LearningPath {
  id          String        @id @default(cuid())
  gameId      String        @map("game_id")
  level       LearningLevel
  title       String
  description String?
  order       Int
  active      Boolean       @default(true)
  createdAt   DateTime      @default(now()) @map("created_at")

  game    Game             @relation(fields: [gameId], references: [id], onDelete: Cascade)
  modules LearningModule[]

  @@unique([gameId, level])
  @@map("learning_paths")
}

model LearningModule {
  id             String @id @default(cuid())
  learningPathId String @map("learning_path_id")
  title          String
  order          Int

  learningPath LearningPath @relation(fields: [learningPathId], references: [id], onDelete: Cascade)
  lessons      Lesson[]

  @@unique([learningPathId, order])
  @@index([learningPathId])
  @@map("learning_modules")
}

// "order" (global dentro do módulo) + LearningModule.order formam a ordem canônica usada por
// learning-progress.util.ts para decidir qual aula desbloqueia a próxima.
model Lesson {
  id               String @id @default(cuid())
  learningModuleId String @map("learning_module_id")
  title            String
  content          String @db.Text
  order            Int

  learningModule  LearningModule           @relation(fields: [learningModuleId], references: [id], onDelete: Cascade)
  exercises       Exercise[]
  progress        UserLessonProgress[]
  recommendations LearningRecommendation[]

  @@unique([learningModuleId, order])
  @@index([learningModuleId])
  @@map("lessons")
}

model Exercise {
  id        String @id @default(cuid())
  lessonId  String @map("lesson_id")
  prompt    String
  kind      String
  answerKey Json?  @map("answer_key")
  order     Int

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
  @@map("exercises")
}

// 1 linha por (usuário, aula) — nunca duplicada (suporta "repetir aula": concluir de novo só
// atualiza completedAt/attempts, não cria uma segunda linha).
model UserLessonProgress {
  id          String               @id @default(cuid())
  userId      String               @map("user_id")
  lessonId    String               @map("lesson_id")
  status      LessonProgressStatus @default(NOT_STARTED)
  attempts    Int                  @default(0)
  completedAt DateTime?            @map("completed_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
  @@map("user_lesson_progress")
}

model UserLearningProfile {
  userId                String        @id @map("user_id")
  level                 LearningLevel @default(BEGINNER)
  goals                 Json?
  onboardingCompletedAt DateTime?     @map("onboarding_completed_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")
  createdAt             DateTime      @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_learning_profiles")
}

// Progresso agregado (Tarefa 16) — uma linha por (userId, gameId), sempre sobrescrita no último
// cálculo (mesmo padrão de TacticalProfile, Tactical Engine Fase 4: sem histórico de snapshots
// anteriores). `metrics` é o resultado já resolvido de agregar Academia/elenco/builds/squads/
// economia/Match Analysis — nunca recalculado a partir do zero por quem lê, só por
// ProgressService. `formulaVersion` versiona a fórmula de agregação (mesmo padrão de
// DECISION_SCORE_CONFIG_VERSION/PLAYER_BUILD_ENGINE_CONFIG_VERSION).
model UserProgressSnapshot {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  gameId         String   @map("game_id")
  computedAt     DateTime @default(now()) @map("computed_at")
  metrics        Json
  formulaVersion String   @map("formula_version")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
  @@index([userId])
  @@map("user_progress_snapshots")
}

// Recomendação adaptativa (Tarefa 17) — "next best action": 1 linha por usuário, sempre
// sobrescrita quando a ação computada muda (mesmo padrão de UserProgressSnapshot/TacticalProfile
// — sem histórico). `type` não estava no esboço original de docs/efootball-architecture.md (só
// tinha reason/lessonId) — adicionado aqui pelo mesmo motivo que UserLearningProfile ganhou
// onboardingCompletedAt na Tarefa 13: torna a linha auto-descritiva em vez de exigir comparar
// texto de `reason` pra saber que ação está ativa. `lessonId` só é preenchido quando a ação é
// "faça esta aula" — as demais ações (onboarding, elenco, squad) não apontam pra nenhuma aula.
model LearningRecommendation {
  id          String    @id @default(cuid())
  userId      String    @unique @map("user_id")
  type        String
  reason      String    @db.Text
  lessonId    String?   @map("lesson_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  dismissedAt DateTime? @map("dismissed_at")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson? @relation(fields: [lessonId], references: [id], onDelete: SetNull)

  @@index([lessonId])
  @@map("learning_recommendations")
}

// Observabilidade de IA (Tarefa 21) — histórico consultável por chamada, fechando a lacuna que a
// Tarefa 20 deixou em aberto (custo calculado e logado por chamada, mas nunca persistido). 1 linha
// por chamada a `EfootballCoachService.runCascade()` (Coach de Elenco/Tarefa 10, Coach de
// Build/Tarefa 14) — inclusive quando todos os provedores falham (`success: false`), pra medir
// taxa de falha, não só custo de sucesso. `userId` opcional (mesmo padrão de `AuditLog`) — grava
// best-effort, nunca deve derrubar o fluxo principal se a escrita falhar.
model AiCallLog {
  id           String   @id @default(cuid())
  feature      String
  provider     String?
  success      Boolean
  costEstimate Float    @default(0) @map("cost_estimate")
  latencyMs    Int      @map("latency_ms")
  errorMessage String?  @map("error_message") @db.Text
  userId       String?  @map("user_id")
  createdAt    DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([feature])
  @@index([userId])
  @@index([createdAt])
  @@map("ai_call_logs")
}

// ─── Base Oficial de Documentação do eFootball (Tarefa 2, prompt separado do módulo eFootball
// de 24 tarefas — ver docs/efootball/documentation-architecture.md) ────────────────────────────

// Nível de confiança OPOSTO ao de sourceType: sourceType descreve A NATUREZA da fonte (quem a
// publicou), trustLevel é a confiança OPERACIONAL atribuída a ela (curável por um admin depois,
// ex.: uma fonte VERIFIED_COMMUNITY pode subir pra HIGH após revisão manual). Regra dura
// (`trust-level.util.ts`): só sourceType OFFICIAL pode ter trustLevel AUTHORITATIVE — nunca uma
// fonte comunitária/manual substitui silenciosamente a confiança de documentação oficial.
enum DocumentationSourceType {
  OFFICIAL
  VERIFIED_COMMUNITY
  COMMUNITY
  MANUAL
}

enum DocumentationTrustLevel {
  AUTHORITATIVE
  HIGH
  MEDIUM
  LOW
}

// `domain` é sempre derivado de `url` pelo service (nunca aceito direto do cliente — client-
// supplied domain que não bate com a URL real seria um jeito de burlar o allowlist de domínio).
// `checksum`/`lastCheckedAt`/`lastSuccessAt`/`lastFailureAt` são escritos pelo futuro coletor
// (Tarefa 4), não pelo CRUD desta tarefa — ficam `null` até lá.
model DocumentationSource {
  id            String                  @id @default(cuid())
  gameId        String                  @map("game_id")
  name          String
  url           String
  domain        String
  sourceType    DocumentationSourceType @map("source_type")
  language      String
  trustLevel    DocumentationTrustLevel @map("trust_level")
  active        Boolean                 @default(true)
  lastCheckedAt DateTime?               @map("last_checked_at")
  lastSuccessAt DateTime?               @map("last_success_at")
  lastFailureAt DateTime?               @map("last_failure_at")
  checksum      String?
  createdAt     DateTime                @default(now()) @map("created_at")
  updatedAt     DateTime                @updatedAt @map("updated_at")

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)
  documents GameDocument[]

  @@unique([gameId, url])
  @@index([gameId])
  @@index([domain])
  @@map("documentation_sources")
}

enum GameDocumentType {
  CONTROLS
  PLAYER_PROGRESSION
  PLAYER_SKILLS
  POSITION_TRAINING
  PLAY_STYLE
  MANAGER
  GAMEPLAY
  VERSION_NOTES
  BALANCE_CHANGE
  GENERAL_GUIDE
}

// Registro do estado ATUAL de 1 documento (Tarefa 3) — histórico de versões anteriores é a
// Tarefa 5 (GameDocumentVersion), não esta tabela. `contentHash` é sempre derivado de
// `normalizedContent` pelo service (`content-hash.util.ts`), nunca aceito do cliente — é o que
// decide se um re-registro no mesmo `url` é "documento duplicado" (hash igual, só atualiza
// `retrievedAt`) ou "conteúdo alterado" (hash diferente, atualiza os campos de conteúdo).
model GameDocument {
  id                String           @id @default(cuid())
  sourceId          String           @map("source_id")
  gameId            String           @map("game_id")
  title             String
  url               String
  documentType      GameDocumentType @map("document_type")
  language          String
  gameVersion       String?          @map("game_version")
  publishedAt       DateTime?        @map("published_at")
  retrievedAt       DateTime         @map("retrieved_at")
  contentHash       String           @map("content_hash")
  rawContent        String           @map("raw_content") @db.Text
  normalizedContent String           @map("normalized_content") @db.Text
  active            Boolean          @default(true)
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  source DocumentationSource   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  game   Game                  @relation(fields: [gameId], references: [id], onDelete: Cascade)
  versions GameDocumentVersion[]
  changes  DocumentChange[]

  @@unique([gameId, url])
  @@index([sourceId])
  @@index([gameId])
  @@index([documentType])
  @@map("game_documents")
}

// Histórico imutável de conteúdo por documento (Tarefa 5) — `GameDocument` acima só guarda o
// ESTADO ATUAL; aqui fica cada versão que já existiu, na íntegra, pra nunca sobrescrever
// silenciosamente documentação anterior. Só é criada uma linha quando `GameDocumentsService`
// detecta mudança real de `contentHash` (documento idêntico não gera versão nova).
// `changeDetected: false` só na versão 1 (não há versão anterior pra comparar — é a linha de
// base); `true` em toda versão 2+ (representa uma alteração real detectada).
model GameDocumentVersion {
  id             String   @id @default(cuid())
  documentId     String   @map("document_id")
  versionNumber  Int      @map("version_number")
  contentHash    String   @map("content_hash")
  content        String   @db.Text
  changeDetected Boolean  @map("change_detected")
  createdAt      DateTime @default(now()) @map("created_at")

  document GameDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, versionNumber])
  @@index([documentId])
  @@map("game_document_versions")
}

enum DocumentChangeType {
  TEXT_ADDED
  TEXT_REMOVED
  TEXT_MODIFIED
  SECTION_ADDED
  SECTION_REMOVED
}

enum DocumentChangeReviewStatus {
  PENDING
  REVIEWED
  APPROVED
  REJECTED
}

// Uma linha por alteração detectada (Tarefa 6) entre duas GameDocumentVersion do mesmo
// documento — não um resumo agregado. `oldVersion`/`newVersion` são `versionNumber`, não FKs
// diretas, porque o par (oldVersion, newVersion) descreve a COMPARAÇÃO, não uma versão em si.
// `reviewStatus` sempre nasce PENDING; a transição pra APPROVED/REJECTED é ação humana — a
// Tarefa 8 (Revisão Humana), fora de escopo aqui. Nenhuma mudança entra em produção sozinha.
model DocumentChange {
  id            String                     @id @default(cuid())
  documentId    String                     @map("document_id")
  oldVersion    Int                        @map("old_version")
  newVersion    Int                        @map("new_version")
  changeType    DocumentChangeType         @map("change_type")
  changeSummary String                     @map("change_summary") @db.Text
  detectedAt    DateTime                   @default(now()) @map("detected_at")
  reviewStatus  DocumentChangeReviewStatus @default(PENDING) @map("review_status")

  document GameDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([reviewStatus])
  @@map("document_changes")
}
