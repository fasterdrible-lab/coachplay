# Database
DATABASE_URL="postgresql://coach_play:coach_play_secret@localhost:5432/coach_play"
POSTGRES_DB=coach_play
POSTGRES_USER=coach_play
POSTGRES_PASSWORD=coach_play_secret

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change_this_to_a_secure_random_string_with_at_least_256_bits
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# AI Providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
AI_FALLBACK_ORDER=anthropic,openai

# Storage
UPLOAD_DIR=./uploads
MAX_VIDEO_SIZE_MB=1024
MAX_VIDEO_DURATION_MINUTES=90

# Email (SMTP) — deixar vazio em dev: o link será logado no console da API
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM="Coach Play <noreply@coachplay.app>"

# App
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Tactical Engine (ver docs/tactical-engine-domain.md) — desabilitado por padrão: nenhuma fase
# foi validada contra dados reais ainda (só fixtures). Setar "true" é uma decisão explícita de
# operação, não o padrão de deploy.
TACTICAL_ENGINE_ENABLED=false

# Base Oficial de Documentação do eFootball (ver docs/efootball/documentation-architecture.md,
# Tarefa 2) — allowlist de domínios autorizados a virar DocumentationSource, separados por
# vírgula. Vazio/ausente por padrão = deny-by-default, nenhuma fonte pode ser cadastrada até um
# operador configurar explicitamente quais domínios são confiáveis (nunca um domínio real
# assumido/adivinhado pelo código). Ex.: DOCUMENTATION_SOURCE_ALLOWED_DOMAINS=konami.com,efootball.com
DOCUMENTATION_SOURCE_ALLOWED_DOMAINS=

# Coletor de documentação (ver docs/efootball/documentation-ingestion.md, Tarefa 4) — todos têm
# defaults sensatos no código; só precisa setar se quiser ajustar. O coletor SEMPRE reaplica
# DOCUMENTATION_SOURCE_ALLOWED_DOMAINS (acima) a cada requisição e a cada salto de redirect.
DOCUMENTATION_FETCH_TIMEOUT_MS=10000
DOCUMENTATION_FETCH_MAX_RETRIES=2
DOCUMENTATION_FETCH_RETRY_DELAY_MS=300
DOCUMENTATION_FETCH_MAX_REDIRECTS=5
DOCUMENTATION_FETCH_MAX_BYTES=2000000
DOCUMENTATION_FETCH_USER_AGENT=CoachPlay-DocBot/1.0

# Deploy em VPS (docker-compose.prod.yml) — ver docs/DEPLOY.md
# Em produção, DATABASE_URL e REDIS_URL acima devem apontar para os serviços
# do compose (host "postgres"/"redis"), não "localhost".
DOMAIN=coachplay.suaempresa.com
LETSENCRYPT_EMAIL=seu-email@suaempresa.com
LETSENCRYPT_STAGING=0
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
